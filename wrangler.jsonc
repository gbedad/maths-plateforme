{
  // Configuration Cloudflare : un Worker qui sert les pages (public/) et l'API (/api/*), avec une base D1.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maths-par-l-exemple",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maths-par-l-exemple",
      // Remplace par l'identifiant donné par : npx wrangler d1 create maths-par-l-exemple
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
