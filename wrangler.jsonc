{
	// Configuration Cloudflare : un Worker qui sert les pages (public/) et l'API (/api/*), avec une base D1.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "maths-plateforme",
	"main": "src/index.js",
	"compatibility_date": "2025-09-01",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "maths-par-l-exemple",
			// Remplace par l'identifiant donné par : npx wrangler d1 create maths-par-l-exemple
			"database_id": "621defa4-5afc-44cd-b96c-5f1a652b24a2",
			"migrations_dir": "migrations"
		},
		{
			"binding": "maths_par_l_exemple",
			"database_name": "maths-par-l-exemple",
			"database_id": "621defa4-5afc-44cd-b96c-5f1a652b24a2"
		}
	],
	"observability": {
		"enabled": true
	}
}
